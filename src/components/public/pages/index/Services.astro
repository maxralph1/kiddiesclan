<style>
    .services {
        margin-top: 2.5rem;
        background-color: #ebd451;
        padding-block: 1.2rem;
        padding-inline: 2rem;
        border-radius: 20px;

        .details {
            font-size: 0.85rem;
            display: flex;
            justify-content: space-between;
            align-items: center;

            .see-services {
                text-wrap: nowrap;
                font-size: 0.75rem;
                display: inline-block;
                padding-block: 0.5rem;
            }
        }

        .services-list {
            display: grid;

            ul {
            order: 2;
            list-style: none;
            padding-left: 0;
            display: flex;
            flex-direction: column;
            gap: 0.95rem;

            li {
                padding-block: 0.05rem;
                padding-inline: 1rem;
                border-radius: 12px;
                border: 1px solid rgba(255, 255, 255, 0.2);
                background: rgba(255, 255, 255, 0.15);
                backdrop-filter: blur(12px);
                -webkit-backdrop-filter: blur(12px);
                box-shadow: inset 0 0 0 1px rgba(255, 255, 255, 0.1);

                h3 {
                margin-bottom: 0;
                }

                p {
                font-size: 0.85rem;
                margin-top: 0.5rem;
                }

                &:hover {
                background: #eeedd9;
                backdrop-filter: unset;
                -webkit-backdrop-filter: unset;
                }
            }
            }

            picture {
            order: 1;

            img {
                align-self: center;
            }
            }
        }
    }

    @media screen and (min-width: 776px) {
        .services {
            .details {
            display: flex;
            align-items: center;
            column-gap: 8rem;

            .see-services {
            }
            }

            .services-list {
            /* display: grid; */
            grid-template-columns: 1fr 1fr;
            align-items: center;
            column-gap: 2rem;

            ul {
                order: 1;

                li {
                h3 {
                }
                p {
                }
                }
            }

            picture {
                order: 2;

                img {
                min-height: 475px;
                }
            }
            }
        }
    }

    @media screen and (min-width: 1024px) {
        .services {
            .details {
            }

            .see-services {
            }

            .services-list {
                ul {
                    li {
                    h3 {
                    }

                    p {
                    }

                    &:hover {
                    }
                    }
                }

                picture {
                    img {
                    min-height: 440px;
                    }
                }
            }
        }
    }

    @media (prefers-color-scheme: dark) {
        .services {
            background-color: #96800394;
            color: #e4ecd1;

            .services-list {
                ul {
                    li {
                        &:hover {
                            background: #9795688e;
                        }
                    }
                }
            }
        }
    }
</style>

