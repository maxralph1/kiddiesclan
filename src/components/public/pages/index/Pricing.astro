                    }
                }

                &.active {
                }
                }
            }

            .details {
                article {
                &.active {
                    h4 {
                    }

                    ul {
                    li {
                    }
                    }

                    .action {
                    .select {
                    }
                    }
                }
                }
            }
            }
        }
    }

    @media (prefers-color-scheme: dark) {
        .pricing {
            color: #e4ecd1;

            .plan-details {
                .plans {
                    .plan {
                        background-color: #4b5701;

                        &.active {
                        background-color: #617000;
                        }
                    }
                }

                .details {
                    article {
                        &.active {
                            /* background-color: #4b5701; */
