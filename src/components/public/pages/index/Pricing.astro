<style>
    .pricing {
        margin-top: 4rem;

        h2,
        p {
            text-align: center;
        }

        p {
            font-size: 0.85rem;
        }

        .plan-details {
            display: flex;
            flex-direction: column;
            gap: 2rem;
            padding-top: 1.25rem;

            .plans {
            display: flex;
            flex-direction: column;
            gap: 1rem;

            .plan {
                background-color: #e4e7db;
                padding: 1rem;
                border-radius: 15px;
                display: flex;
                justify-content: space-between;
                align-items: center;
                gap: 1rem;

                h3,
                span {
                font-size: 0.85rem;
                }

                h3 {
                text-wrap: nowrap;

                .save {
                    margin-left: 0.2rem;
                    padding-inline: 0.2rem;
                    font-size: 0.65rem;
                    font-weight: 500;
                    border-radius: 12px;
                    border: 1px solid rgb(255, 255, 255);
                    background: rgba(255, 255, 255, 0.15);
                    backdrop-filter: blur(12px);
                    -webkit-backdrop-filter: blur(12px);
                    box-shadow: inset 0 0 0 1px rgba(255, 255, 255, 0.1);
                }
                }

                span {
                text-align: end;

                .price {
                    font-size: 1.5rem;
                    font-weight: 700;
                }

                .time {
                    font-size: 0.7rem;
                    font-weight: 400;
                }
                }

                &.active {
                background-color: #c4eb89;
                }
            }
            }

            .details {
                article {
                    display: none;
                    opacity: 0;
                    transform: translateY(10px);
                    pointer-events: none;
                    transition:
                    opacity 300ms ease,
                    transform 300ms ease;

                    &.active {
                    background-color: #e4e7db;
                    padding-inline: 1rem;
                    padding-block: 2rem;
                    border-radius: 15px;
                    display: flex;
                    flex-direction: column;
                    gap: 0;
                    opacity: 1;
                    transform: translateY(0);
                    pointer-events: auto;

                    h4 {
                        margin-block: 0;
                    }

                    ul {
                        list-style: none;
                        padding-left: 0;
                        display: flex;
                        flex-direction: column;
                        gap: 0.75rem;

                        li {
                        font-size: 0.85rem;
                        background: url('/images/kids-building.jpg') no-repeat;
                        background-size: 1rem 1rem;
                        padding-left: 1.5rem;
                        margin-bottom: 0.5rem;
                        }
                    }

                    .action {
                        margin-top: 0.75rem;
                        width: 100%;
                        align-self: stretch;
                        font-size: 0.75rem;

                        .select {
                        width: 100%;
                        }
                    }
                    }
                }
            }
        }
    }

