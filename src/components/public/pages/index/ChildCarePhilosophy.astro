<style>
    .childcare-philosophy {
        h2 {
            text-align: center;
        }

        .cards {
            display: flex;
            flex-direction: column;
            gap: 1rem;

            .card {
            flex: 1;
            border-radius: 10px;
            background-color: #f5f5f5;
            padding-block: 0.25rem;
            padding-inline: 0.25rem;
            text-align: center;

            picture {
                img {
                }
            }

            h3 {
                margin-bottom: 0;
                padding-bottom: 0.25rem;
                padding-inline: 1rem;
                font-size: 1rem;
            }

            p {
                margin-top: 0;
                padding-inline: 1rem;
                font-size: 0.85rem;
            }
            }
        }
    }

    @media screen and (min-width: 776px) {
        .childcare-philosophy {
            h2 {
                text-align: start;
            }

            .cards {
            /* display: flex; */
            flex-direction: row;

            .card {
                h3 {
                }
                p {
                }
            }
            }
        }
    }

    @media (prefers-color-scheme: dark) {
        .childcare-philosophy {
            color: #e4ecd1;

            .cards {
                .card {
                    background-color: #4b5701;
                }
            }
        }
    }
</style>

