<style>
    .reviews {
        margin-top: 4rem;
        background-color: #e4e7db;
        border-radius: 15px;
        padding: 1rem;
        display: grid;

        .intro {
            order: 1;

            p {
            font-size: 0.85rem;
            }
        }

        .client-reviews {
            order: 3;
            padding-top: 1.05rem;
            padding-bottom: 0.5rem;

            .client-reviews-slide {
            position: relative;
            height: auto;
            min-height: 3rem;

            .client-review {
                font-weight: 600;
                display: none;
                position: absolute;
                width: 100%;
                top: 0;
                left: 0;

                &.active {
                display: block;
                }
            }
            }

            .client-review-navigator {
            padding-top: 1rem;
            display: flex;
            justify-content: center;
            gap: 1rem;

            .left,
            .right {
                display: flex;
                cursor: pointer;
            }
            }
        }

        .client {
            order: 2;
            display: flex;
            flex-direction: column;
            padding-top: 1.5rem;
            padding-bottom: 0.35rem;

            .name {
            order: 2;
            align-self: center;
            text-align: center;

            h3 {
                margin-bottom: 0;
            }
            span {
                font-size: 0.8rem;
            }
            }
            img {
            order: 1;
            width: 150px;
            height: 175px;
            align-self: center;
            }
        }
    }

    @media screen and (min-width: 776px) {
        .reviews {
            display: grid;
            grid-template-columns: 4fr 5fr 2fr;
            align-items: center;

            .intro {
            order: 1;
            /* align-self: start; */
            padding-inline: 1rem;

            p {
                font-size: 0.85rem;
            }
            }

            .client-reviews {
            order: 2;
            padding-top: 0rem;
            padding-bottom: 0.5rem;
            padding-inline: 1.5rem;

            .client-reviews-slide {
                position: relative;
                height: auto;
                min-height: 5rem;

                .client-review {
                &.active {
                }
                }
            }

            .client-review-navigator {
                padding-top: 1rem;
                display: flex;
                justify-content: center;
                gap: 1rem;

                .left,
                .right {
                display: flex;
                cursor: pointer;
                }
            }
            }

            .client {
            order: 3;
            /* justify-self: end; */

            .name {
                h3 {
                }
                span {
                }
            }
            img {
            }
            }
        }
    }

    @media (prefers-color-scheme: dark) {
        .reviews {
            background-color: #4b5701;
            color: #e4ecd1;
        }
    }
</style>

<section id='reviews' class='reviews'>
    <div class='intro'>
    <h2>Trusted by parents like you</h2>

    <p>
        Explore all our plans today and find the perfect solution for your
        family's childcare needs.
    </p>
    </div>

    <div class='client-reviews'>
    <section class='client-reviews-slide'>
        <article class='client-review active'>
        <q>
            My son always lights up when he sees his nanny. Knowing he's in
            such loving hands lets me focus on my work without distractions.
        </q>
        </article>
        <article class='client-review'>
        <q> My daughter is all smiles when she sees her nanny. </q>
        </article>
    </section>

    <div class='client-review-navigator'>
        <span class='left light-button'>
        <svg
            class='w-6 h-6 text-gray-800 dark:text-white'
            aria-hidden='true'
            xmlns='http://www.w3.org/2000/svg'
            width='24'
            height='24'
            fill='none'
            viewBox='0 0 24 24'
        >
            <path
            stroke='currentColor'
            stroke-linecap='round'
            stroke-linejoin='round'
            stroke-width='2'
            d='M5 12h14M5 12l4-4m-4 4 4 4'
            >
            </path>
        </svg>
        </span>
        <span class='right light-button'>
        <svg
            class='w-6 h-6 text-gray-800 dark:text-white'
            aria-hidden='true'
            xmlns='http://www.w3.org/2000/svg'
            width='24'
            height='24'
            fill='none'
            viewBox='0 0 24 24'
        >
            <path
            stroke='currentColor'
            stroke-linecap='round'
            stroke-linejoin='round'
            stroke-width='2'
            d='M19 12H5m14 0-4 4m4-4-4-4'></path>
        </svg>
        </span>
    </div>
    </div>

    <div class='client'>
    <div class='name'>
        <h3>Jane Cooper</h3>
        <span>Parent</span>
    </div>
    <img
        src='/images/kids-building.jpg'
        alt='ChildCare Philosophy Image 3'
    />
    </div>
</section>