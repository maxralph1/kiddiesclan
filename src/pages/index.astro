---
// import Welcome from '../components/Welcome.astro'
import Layout from '../layouts/Layout.astro'
import Header from '../components/public/Header.astro'
import Footer from '../components/public/Footer.astro'
import Hero from '../components/public/pages/index/Hero.astro'
import ChildCarePhilosophy from '../components/public/pages/index/ChildCarePhilosophy.astro'
import NurturingLittleOnes from '../components/public/pages/index/NurturingLittleOnes.astro'
import Services from '../components/public/pages/index/Services.astro'
import SafetyMeasures from '../components/public/pages/index/SafetyMeasures.astro'
import Pricing from '../components/public/pages/index/Pricing.astro'
import Reviews from '../components/public/pages/index/Reviews.astro'

const companyName = 'KiddiesClan'
---

<style>
  main {
    margin-top: 4rem;
    padding-inline: 1.5rem;

    .parting-note {
      margin-top: 4rem;
      display: flex;
      flex-direction: column;
      align-items: center;
      text-align: center;

      .logo {
        img {
        }
      }

      .details {
        p {
          font-size: 0.85rem;
        }
        .actions {
          display: flex;
          align-items: center;
          justify-content: center;
          gap: 1rem;
          flex-wrap: wrap;
        }
      }
    }
  }

  @media screen and (min-width: 776px) {
    main {
      padding-inline: 2.5rem;
    }
  }

  @media screen and (min-width: 1024px) {
  }

  @media (prefers-color-scheme: dark) {
    main {
      .parting-note {
        color: #e4ecd1;
      }
    }
  }
</style>

<Layout>
  <Header />

  <Hero />

  <main>
    <ChildCarePhilosophy />

    <NurturingLittleOnes />

    <Services />

    <SafetyMeasures />

    <Pricing />

    <Reviews />

    <section class='parting-note'>
      <div class='logo'>
        <img src='#' alt='Brand logo' />
      </div>

      <div class='details'>
        <h2>Discover Babycare Made Easy for You</h2>

        <p>
          We're committed to providing your family with safe, reliable,
          committed and loving childcare.
        </p>

        <div class='actions'>
          <a href='#' class='get-started dark-button'>Get Started</a>
          <a href='' class='join-community light-button'>Join Our Community</a>
        </div>
      </div>
    </section>
  </main>

  <Footer />

  <script is:client='load'>
    document.addEventListener('DOMContentLoaded', function () {
      // =========================================================
      // REVIEW SLIDER WITH:
      // - Fade animation
      // - Auto slide
      // - Manual prev/next
      // - Touch / Swipe support
      // =========================================================
      const slides = document.querySelectorAll('.client-review')
      const leftBtn = document.querySelector('.client-review-navigator .left')
      const rightBtn = document.querySelector('.client-review-navigator .right')
      const slider = document.querySelector('.client-reviews')

      let currentSlide = 0
      let intervalId = null

      // Prepare the fade animation for all slides
      slides.forEach((slide) => {
        slide.style.opacity = '0'
        slide.style.transition = 'opacity 600ms ease'
        slide.style.position = 'absolute'
        slide.style.left = '0'
        slide.style.right = '0'
      })

      function showSlide(index) {
        slides.forEach((slide, i) => {
          slide.classList.remove('active')
          slide.style.opacity = i === index ? '1' : '0'
          if (i === index) slide.classList.add('active')
        })
      }

      function nextSlide() {
        currentSlide = (currentSlide + 1) % slides.length
        showSlide(currentSlide)
      }

      function prevSlide() {
        currentSlide = (currentSlide - 1 + slides.length) % slides.length
        showSlide(currentSlide)
      }

      function startAutoSlide() {
        intervalId = setInterval(nextSlide, 4000)
      }

      function stopAutoSlide() {
        clearInterval(intervalId)
      }

      // Manual buttons
      if (rightBtn) {
        rightBtn.addEventListener('click', function () {
          stopAutoSlide()
          nextSlide()
          startAutoSlide()
        })
      }

      if (leftBtn) {
        leftBtn.addEventListener('click', function () {
          stopAutoSlide()
          prevSlide()
          startAutoSlide()
        })
      }

      // Hover pause
      if (slider) {
        slider.addEventListener('mouseenter', stopAutoSlide)
        slider.addEventListener('mouseleave', startAutoSlide)
      }

      // =========================================================
      // TOUCH / SWIPE SUPPORT
      // =========================================================
      let startX = 0
      let endX = 0

      if (slider) {
        slider.addEventListener('touchstart', function (e) {
          startX = e.touches[0].clientX
        })

        slider.addEventListener('touchend', function (e) {
          endX = e.changedTouches[0].clientX
          const diff = endX - startX

          // Detect swipe threshold ~50px
          if (Math.abs(diff) > 50) {
            stopAutoSlide()
            if (diff < 0)
              nextSlide() // swipe left → next
            else prevSlide() // swipe right → previous
            startAutoSlide()
          }
        })
      }

      // =========================================================
      // INITIALIZE
      // =========================================================
      showSlide(currentSlide)
      startAutoSlide()

      // =========================================================
      // INTERACTIVE PRICING SECTION
      // =========================================================

      const planButtons = document.querySelectorAll('.pricing .plan')
      const planDetails = document.querySelectorAll('.pricing .details article')

      function activatePlan(index) {
        // Remove active from all plans
        planButtons.forEach((btn) => btn.classList.remove('active'))
        // Remove active from all detail articles
        planDetails.forEach((detail) => detail.classList.remove('active'))

        // Activate selected
        planButtons[index].classList.add('active')
        planDetails[index].classList.add('active')
      }

      // function activatePlan(index) {
      //   // Remove active from all plans
      //   planButtons.forEach((btn) => btn.classList.remove('active'))

      //   // Fade out all articles
      //   planDetails.forEach((detail) => {
      //     detail.classList.remove('active')
      //   })

      //   // Slight delay for smooth fade (prevents overlap)
      //   setTimeout(() => {
      //     planButtons[index].classList.add('active')
      //     planDetails[index].classList.add('active')
      //   }, 10) // small delay helps transition start correctly
      // }

      // Attach click events
      planButtons.forEach((btn, index) => {
        btn.addEventListener('click', () => {
          activatePlan(index)
        })
      })
    })
  </script>
</Layout>
